<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.thompgt.enricher</groupId>
    <artifactId>kafka-model-enricher</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>enricher-app</artifactId>
  <name>enricher-app</name>
  <description>
    Spring Boot wiring, configuration, Actuator and Micrometer. The framework
    lives here and only here (CLAUDE.md invariant 3).
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.thompgt.enricher</groupId>
      <artifactId>enricher-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.thompgt.enricher</groupId>
      <artifactId>enricher-model</artifactId>
    </dependency>

    <!--
      Web starter rather than the plain one: Actuator's health and Prometheus
      endpoints need a servlet container to be reachable, and NFR / Phase 8 make
      those endpoints part of the deliverable.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
