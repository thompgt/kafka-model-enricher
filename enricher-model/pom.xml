<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.thompgt.enricher</groupId>
    <artifactId>kafka-model-enricher</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>enricher-model</artifactId>
  <name>enricher-model</name>
  <description>
    ModelClient implementations: the local Ollama backend, and the deterministic
    fake with injectable latency, error classes and malformed responses. See
    docs/adr/0003 for why both are first-class.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.thompgt.enricher</groupId>
      <artifactId>enricher-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!--
      HTTP is java.net.http from the JDK. No client library here: this module is
      on the per-event path, and every dependency on it is a dependency in the
      hot path. Response schema validation arrives with Phase 4.
    -->
  </dependencies>
</project>
